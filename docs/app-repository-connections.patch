+  async getIssueProviderConnections(): Promise<IssueProviderConnection[]> {
+    const providers = await firstValueFrom(this._store.select(selectAllIssueProviders));
+    return providers.filter((provider) => provider.issueProviderKey === 'GITEA').map((provider) => {
+      // Old local builds stored config under pluginConfig. Never return the token.
+      const legacy = (provider as unknown as { pluginConfig?: Record<string, unknown> }).pluginConfig;
+      const config = (legacy && !('host' in provider) ? legacy : provider) as unknown as Record<string, unknown>;
+      const text = (key: string): string => typeof config[key] === 'string' ? config[key] as string : '';
+      return {
+        id: provider.id,
+        projectId: provider.defaultProjectId || null,
+        issueProviderKey: provider.issueProviderKey,
+        isEnabled: provider.isEnabled,
+        host: text('host'),
+        repoFullname: text('repoFullname'),
+        scope: text('scope'),
+        filterLabels: text('filterLabels'),
+        excludeLabels: text('excludeLabels'),
+        isAutoPoll: provider.isAutoPoll,
+        isAutoAddToBacklog: provider.isAutoAddToBacklog,
+        pollingMode: provider.pollingMode,
+      };
+    });
+  }
