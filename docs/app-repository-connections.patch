+import { TestBed } from '@angular/core/testing';
+import { MockStore, provideMockStore } from '@ngrx/store/testing';
+import { IssueProviderGitea } from '../features/issue/issue.model';
+import {
+  PluginRepositoryConnectionsService,
+  repositoryConnections,
+} from './plugin-repository-connections.service';
+import { ISSUE_PROVIDER_FEATURE_KEY } from '../features/issue/store/issue-provider.reducer';
+
+const provider: IssueProviderGitea = {
+  id: 'gitea-one',
+  isEnabled: true,
+  issueProviderKey: 'GITEA',
+  pluginId: 'gitea-issue-provider',
+  defaultProjectId: 'project-one',
+  isAutoPoll: true,
+  isAutoAddToBacklog: false,
+  isIntegratedAddTaskBar: false,
+  pollingMode: 'always',
+  defaultTagIds: [],
+  pinnedSearch: null,
+  defaultNote: null,
+  pluginConfig: {
+    host: 'https://git.example.test',
+    repoFullname: 'owner/repo',
+    scope: 'all',
+    token: 'PRIVATE-TOKEN',
+    extraSecret: 'EXTRA-SECRET',
+  },
+};
+
+describe('PluginRepositoryConnectionsService', () => {
+  it('projects metadata from the v19.1 migrated Gitea shape without credentials', () => {
+    const output = repositoryConnections([provider]);
+    expect(output[0].host).toBe('https://git.example.test');
+    expect(output[0].repoFullname).toBe('owner/repo');
+    expect(output[0].configFormat).toBe('plugin');
+    expect(output[0].projectId).toBe('project-one');
+    expect(JSON.stringify(output)).not.toContain('PRIVATE-TOKEN');
+    expect(JSON.stringify(output)).not.toContain('EXTRA-SECRET');
+    expect(provider.pluginConfig['token']).toBe('PRIVATE-TOKEN');
+  });
+
+  it('reads current store state rather than a cached connection list', async () => {
+    TestBed.configureTestingModule({
+      providers: [PluginRepositoryConnectionsService, provideMockStore()],
+    });
+    const store = TestBed.inject(MockStore);
+    const service = TestBed.inject(PluginRepositoryConnectionsService);
+    store.setState({
+      [ISSUE_PROVIDER_FEATURE_KEY]: {
+        ids: [provider.id],
+        entities: { [provider.id]: provider },
+      },
+    });
+    expect((await service.getConnections())[0].repoFullname).toBe('owner/repo');
+    store.setState({
+      [ISSUE_PROVIDER_FEATURE_KEY]: {
+        ids: [provider.id],
+        entities: {
+          [provider.id]: {
+            ...provider,
+            pluginConfig: { ...provider.pluginConfig, repoFullname: 'owner/new' },
+          },
+        },
+      },
+    });
+    expect((await service.getConnections())[0].repoFullname).toBe('owner/new');
+  });
+});
diff --git c/src/app/plugins/plugin-repository-connections.service.ts i/src/app/plugins/plugin-repository-connections.service.ts
new file mode 100644
index 000000000..3ec43919e
--- /dev/null
+++ i/src/app/plugins/plugin-repository-connections.service.ts
@@ -0,0 +1,45 @@
+import { inject, Injectable } from '@angular/core';
+import { Store } from '@ngrx/store';
+import { firstValueFrom } from 'rxjs';
+import { IssueProviderConnection } from '@super-productivity/plugin-api';
+import { selectAll } from '../features/issue/store/issue-provider.selectors';
+import { IssueProvider, IssueProviderGitea } from '../features/issue/issue.model';
+
+export const repositoryConnections = (
+  providers: IssueProvider[],
+): IssueProviderConnection[] =>
+  providers
+    .filter(
+      (provider): provider is IssueProviderGitea => provider.issueProviderKey === 'GITEA',
+    )
+    .map((provider): IssueProviderConnection => {
+      const cfg = provider.pluginConfig;
+      const text = (key: string): string =>
+        typeof cfg[key] === 'string' ? (cfg[key] as string) : '';
+      // Whitelist metadata: tokens and other provider credentials never leave this reader.
+      return {
+        id: provider.id,
+        projectId: provider.defaultProjectId || null,
+        issueProviderKey: provider.issueProviderKey,
+        pluginId: provider.pluginId,
+        configFormat: 'plugin',
+        isEnabled: provider.isEnabled,
+        host: text('host'),
+        repoFullname: text('repoFullname'),
+        scope: text('scope'),
+        filterLabels: text('filterLabels'),
+        excludeLabels: text('excludeLabels'),
+        isAutoPoll: provider.isAutoPoll ?? false,
+        isAutoAddToBacklog: provider.isAutoAddToBacklog ?? false,
+        pollingMode: provider.pollingMode ?? 'whenProjectOpen',
+      };
+    });
+
+@Injectable({ providedIn: 'root' })
+export class PluginRepositoryConnectionsService {
+  private _store = inject(Store);
+
+  async getConnections(): Promise<IssueProviderConnection[]> {
+    return repositoryConnections(await firstValueFrom(this._store.select(selectAll)));
+  }
+}
