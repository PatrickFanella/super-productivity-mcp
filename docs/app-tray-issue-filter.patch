diff --git i/src/app/features/tasks/store/task-electron.effects.spec.ts w/src/app/features/tasks/store/task-electron.effects.spec.ts
index e7fee4c3d..2544a993d 100644
--- i/src/app/features/tasks/store/task-electron.effects.spec.ts
+++ w/src/app/features/tasks/store/task-electron.effects.spec.ts
@@ -94,0 +95,20 @@ describe('TaskElectronEffects', () => {
+  describe('syncTodayTasksToElectron$', () => {
+    it('keeps plain tasks and calendar events while hiding repository issues', () => {
+      const plain = { ...task, id: 'plain' };
+      const calendar: Task = { ...task, id: 'calendar', issueType: 'ICAL' };
+      const issue: Task = { ...task, id: 'issue', issueType: 'GITEA' };
+      const done = { ...task, id: 'done', isDone: true };
+      store.overrideSelector(selectTaskEntities, { plain, calendar, issue, done });
+      store.overrideSelector(selectTodayTaskIds, ['plain', 'issue', 'calendar', 'done']);
+      store.refreshState();
+      const spy = spyOn(window.ea, 'updateTodayTasks');
+      const sub = effects.syncTodayTasksToElectron$.subscribe();
+      sub.unsubscribe();
+      expect(spy.calls.mostRecent().args[0].map((t) => t.id)).toEqual([
+        'plain',
+        'calendar',
+      ]);
+      expect(issue.issueType).toBe('GITEA');
+    });
+  });
+
